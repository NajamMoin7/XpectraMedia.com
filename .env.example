# Payment gateway (NMI compatible). Copy to .env.local and fill in.
# On Netlify set these under Site configuration > Environment variables,
# for both the Builds and Functions scopes.

# Collect.js public tokenization key (safe to expose to the browser)
PUBLIC_KEY=""
# Private security key, used only by the server route /api/checkout/charge
SECRET_KEY=""
# Direct Post API endpoint
POST_URL="https://daystarpayments.transactiongateway.com/api/transact.php"
